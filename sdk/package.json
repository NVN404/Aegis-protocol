{
  "name": "monad-passkey-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monad Passkey PoP — SDK Monorepo",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:all": "pnpm -r build",
    "dev": "pnpm -r --parallel --filter './packages/*' dev",
    "type-check": "pnpm -r --filter './packages/*' type-check",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "example": "pnpm --filter example-nextjs dev"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsup": "^8.1.0",
    "prettier": "^3.3.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
