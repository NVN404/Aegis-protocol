{
  "name": "@monad-passkey/react",
  "version": "0.1.0",
  "description": "React hooks and context for Monad Passkey Proof of Personhood — FaceID/TouchID onchain identity",
  "keywords": ["monad", "passkey", "react", "hooks", "webauthn", "web3", "proof-of-personhood"],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "ethers": "^6.0.0"
  },
  "dependencies": {
    "@monad-passkey/core": "workspace:*",
    "@monad-passkey/contracts": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ethers": "^6.13.5",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "@types/react": "^19"
  }
}
